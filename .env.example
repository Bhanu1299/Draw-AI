# Copy to .env.local and fill in. Never commit .env.local.
# Which AI builds pages: "deepseek" (default) or "anthropic".
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Voice (M2b): an ElevenLabs API key with speech-to-text access.
ELEVENLABS_API_KEY=
